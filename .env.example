# Required, and the only API key this project uses. Every stage runs on it,
# including retrieval query expansion and evidence reranking.
# Keep the real key only in .env.local.
ANTHROPIC_API_KEY=

# Optional Claude model overrides.
ANTHROPIC_WORK_MODEL=claude-opus-5
ANTHROPIC_JUDGE_MODEL=claude-opus-5

# Optional stable salt for pseudonymous per-student request identifiers.
SAFETY_IDENTIFIER_SALT=replace-with-a-random-secret

# Optional absolute path for the JSON run store.
# FEEDBACK_DATA_DIR=/absolute/path/to/private/data

# Optional. Model used only when a safety classifier declines a request.
# ANTHROPIC_FALLBACK_MODEL=claude-opus-4-8
