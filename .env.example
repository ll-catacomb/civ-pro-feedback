# HUIT AI Services / AWS Bedrock. Use the API key (not the separately issued
# app secret) from the Harvard API Portal. It is sent only in the x-api-key
# header. Every feedback stage runs through this gateway.
HUIT_BEDROCK_API_KEY=
HUIT_BEDROCK_BASE_URL=https://apis.huit.harvard.edu/ais-bedrock-llm/v2
# US cross-region inference keeps processing within US AWS regions. Sonnet 5
# handles supporting stages; Opus 5.5 owns banding and skeptical judgment.
HUIT_BEDROCK_FAST_MODEL=us.anthropic.claude-sonnet-5
HUIT_BEDROCK_WORK_MODEL=us.anthropic.claude-sonnet-5
HUIT_BEDROCK_EVALUATOR_MODEL=us.anthropic.claude-opus-5-5
HUIT_BEDROCK_JUDGE_MODEL=us.anthropic.claude-opus-5-5
# HUIT's current proxy rejects output_config.format even though Bedrock supports
# it. Keep false until a live HUIT request confirms native structured outputs.
HUIT_BEDROCK_STRUCTURED_OUTPUT=false
# Optional per-request timeout; default is 300000 (5 minutes), leaving room for
# the stage's controlled retry/fallback inside the hosting function lifetime.
# HUIT_BEDROCK_TIMEOUT_MS=300000

# Google Sheets storage. The service account must be shared onto the private
# identity spreadsheet and the submissions/feedback spreadsheet. During
# synthetic testing both IDs may point to one workbook; production should use
# separate spreadsheets so staff access cannot reveal the identity mapping.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Local alternative to the two values above. Put the downloaded JSON under the
# gitignored .data directory; production deployments should use secret env vars.
# GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_FILE=.data/google-service-account.json
GOOGLE_IDENTITY_SPREADSHEET_ID=
GOOGLE_FEEDBACK_SPREADSHEET_ID=

# Signed Apps Script write gate. It serializes pseudonym assignment and attempt
# reservations with LockService so two requests cannot consume attempt five.
GOOGLE_ATTEMPT_GATE_URL=
GOOGLE_ATTEMPT_GATE_SECRET=

# Keyed lookup secret for matching a verified Google address to the opaque
# value in Enrollment column B. Use a separate random value of 32+ characters.
# Plaintext student emails are never written to Google Sheets or session data.
STUDENT_EMAIL_LOOKUP_SECRET=

# Synthetic student portal. Development defaults to enabled unless explicitly
# set to false; production requires false so no demo identities are exposed.
STUDENT_DEMO_MODE=false

# Auth.js sessions use signed JWT cookies, so no auth database is introduced.
# Students authenticate with the Harvard Google account listed on the private
# course roster. The verified email is used only for the keyed lookup and is
# not retained in the student record or session.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google Workspace email domains allowed for student sign-in.
# Each entry also admits its subdomains.
GOOGLE_WORKSPACE_DOMAIN=

# Optional absolute path for the JSON run store.
# FEEDBACK_DATA_DIR=/absolute/path/to/private/data
